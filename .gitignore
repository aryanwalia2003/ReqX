# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Env files (usually contain secrets)
.env

# Editor and IDE settings
.vscode/
# ...except the app/frontend project's shared recommended-extensions/settings,
# which are meant to be committed for onboarding DX.
!/app/frontend/.vscode/
.idea/
*.swp
*.~

# ReqX specific build artifacts
dist/
# ...except app/frontend/dist, which app/frontend/.gitignore governs itself
# (it keeps a committed index.html placeholder for go:embed — see there).
!/app/frontend/dist/
reqx-windows.zip
reqx.exe

# Postman CLI specific test files
test-env.json
test-collection.json
test-socketio.json
# root-level only — scoped so app/frontend's package.json, tsconfig.json,
# wails.json etc. aren't accidentally swallowed too.
/*.json

.agents

behavioral-workflow-proposal.md
personas-guide.md

*.csv

*.prof
*.pprof
*.trace
reqx
reqx.test
reqx-race